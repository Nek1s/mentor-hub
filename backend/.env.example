# Скопируйте этот файл в backend/.env и укажите свои значения PostgreSQL.
# Вместо CHANGE_ME укажите пароль пользователя, созданного в pgAdmin.
DATABASE_URL=postgresql+psycopg://mentorhub_user:CHANGE_ME@localhost:5432/mentorhub
APP_NAME=MentorHub API
DEBUG=true
# Сгенерируйте уникальную длинную строку для локального файла .env. Не добавляйте её в Git.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
